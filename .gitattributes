# Git LFS — large binary assets
# Enable with: git lfs install

# Microscopy formats (workshop images)
*.tif filter=lfs diff=lfs merge=lfs -text
*.TIF filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.lsm filter=lfs diff=lfs merge=lfs -text
*.LSM filter=lfs diff=lfs merge=lfs -text
*.zvi filter=lfs diff=lfs merge=lfs -text
*.czi filter=lfs diff=lfs merge=lfs -text
*.nd2 filter=lfs diff=lfs merge=lfs -text

# Office binaries
*.docx filter=lfs diff=lfs merge=lfs -text
*.doc  filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.ppt  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls  filter=lfs diff=lfs merge=lfs -text
*.potx filter=lfs diff=lfs merge=lfs -text

# PDFs (handouts and references)
*.pdf filter=lfs diff=lfs merge=lfs -text

# Notes:
# - .ipynb intentionally NOT in LFS (text-based JSON; needs to be
#   diff-friendly for code review)
# - .png / .jpg intentionally NOT in LFS by default (most are small
#   logos/figures; switch on per-file if any single asset gets > ~5 MB)
